/* Centered for now — move to final position later. */
.scoreboard-root {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;

    background-color: rgba(0, 0, 0, 0.78);
    border-radius: 14px;
    padding: 18px 28px;

    min-width: 360px;
}

.scoreboard-title {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 14px;
    letter-spacing: 4px;
}

.scoreboard-rows {
    flex-direction: column;
}

.score-row {
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.10);
}

.row-rank {
    width: 36px;
    -unity-text-align: middle-center;
    color: rgb(180, 180, 180);
    font-size: 20px;
    -unity-font-style: bold;
}

.row-name {
    flex-grow: 1;
    color: rgb(220, 220, 220);
    font-size: 20px;
    margin-left: 14px;
}

.row-score {
    color: rgb(220, 220, 220);
    font-size: 22px;
    -unity-font-style: bold;
    margin-left: 14px;
    min-width: 90px;
    -unity-text-align: middle-right;
}

/* Highlight the local player's row. */
.score-row.me {
    background-color: rgba(255, 215, 0, 0.10);
    border-radius: 6px;
}

.score-row.me .row-name {
    color: rgb(255, 220, 100);
    -unity-font-style: bold;
}

.score-row.me .row-score {
    color: rgb(255, 220, 100);
}

.score-row.me .row-rank {
    color: rgb(255, 220, 100);
}
